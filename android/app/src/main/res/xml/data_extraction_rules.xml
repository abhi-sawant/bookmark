<?xml version="1.0" encoding="utf-8"?>
<!--
  Same allowlist as backup_rules.xml; see the note there about thumbnails.

  The "account" DataStore file (bearer token, signed-in email) is explicitly
  excluded from both cloud backup and device-to-device transfer: a synced
  token should never leave the device this way (spec/plan §2.2).
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore" />
        <exclude domain="file" path="datastore/account.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore" />
        <exclude domain="file" path="datastore/account.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
